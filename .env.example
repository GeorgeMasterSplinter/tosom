# ToSom Production Environment
NODE_ENV=production
TOSOM_ENV=production
DATABASE_URL="your_database_url_here"
DIRECT_URL="your_direct_url_here"
# ⚠️ For dev: Auth.js les AUTH_SECRET eller NEXTAUTH_SECRET
# Generer ein stabil verdi med: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
NEXTAUTH_URL=https://tosom.no
NEXTAUTH_SECRET="din-stabil-auth-secret-verdi-here-generer-med-crypto"
API_BASE_URL=https://api.tosom.no
FRONTEND_BASE_URL=https://tosom.no

# ─── SMTP / Magic Link ───
EMAIL_SERVER_HOST=smtp.resend.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=resend_user
EMAIL_SERVER_PASSWORD=your_resend_api_key
EMAIL_FROM="ToSom <no-reply@tosom.no>"

# ─── AI ───
AI_API_KEY="SETT_INN_DIN_AI_NOKKEL_HER"
AI_MODEL=gpt-4

# ─── Upload ───
UPLOADTHING_TOKEN="SETT_INN_UPLOADTHING_TOKEN"

# ─── Logging & sikkerheit ───
LOG_LEVEL=info
ENABLE_AI_LOGGING=true
ENABLE_AUDIT_LOG=true
HTTPS=true
HSTS_MAX_AGE=31536000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_MAX_LOGIN_ATTEMPTS=5
CACHE_TTL=300

# ─── Admin tilgang ───
# Brukarnavn og passord for admin-panel-innlogging.
# PROD: Generer sterke, random verdiar!
ADMIN_USERNAME=MasterSplinter
ADMIN_PASSWORD=SauLasa26

# ⚠️  CRITICAL: Set a strong admin password in production.
# ⚠️  NEVER use "admin" or any default value in production.
# ⚠️  Generate a strong random password instead.
ADMIN_PASSWORD_PROD="CHANGE_ME_IN_PRODUCTION"

# ─── Cron-Job Secret ───
CRON_SECRET="SETT_INN_CRON_SECRET_HER"

# ─── Vipps OAuth ───
VIPPS_CLIENT_ID="SETT_INN_VIPPS_CLIENT_ID_HER"
VIPPS_CLIENT_SECRET="SETT_INN_VIPPS_CLIENT_SECRET_HER"
VIPPS_ISSUER="https://api.vipps.no"

# ─── Vipps Payment (valgfritt for premium-abonnement) ───
VIPPS_PAYMENT_TOKEN="SETT_INN_VIPPS_PAYMENT_TOKEN_HER"
