# ToSom — Test Environment Configuration
# Bruk: cp .env.test .env.test.local
# Deretter: DATABASE_URL=${TEST_DATABASE_URL}

# ─── Database (Test) ───
TEST_DATABASE_URL="postgresql://tosom:tosom@localhost:5433/tosom_test"

# ─── NextAuth ───
NEXTAUTH_SECRET="test-secret-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# ─── Feature Flags ───
DEV_LOGIN_ENABLED=true

# ─── Dev-specific ───
NODE_ENV="test"

# ─── AI (test-mode, ingen kostnader) ───
AI_API_KEY="test-key-does-not-work"
AI_PROVIDER="test"

# ─── Stripe (testmode) ───
STRIPE_SECRET_KEY="sk_test_fake"
STRIPE_WEBHOOK_SECRET="whsec_test_fake"

# ─── Uploadthing ───
UPLOADTHING_SECRET="test-secret"
UPLOADTHING_APP_ID="test-app"

# ─── Pusher ───
PUSHER_APP_ID="test-app-id"
PUSHER_KEY="test-key"
PUSHER_SECRET="test-secret"
PUSHER_CLUSTER="test"

# ─── Supabase ───
SUPABASE_URL="http://localhost:54321"
SUPABASE_KEY="test-key"

# ─── Logging ───
LOG_LEVEL="debug"