# ToSom Production Environment
NODE_ENV=production
TOSOM_ENV=production
DATABASE_URL="your_database_url_here"
DIRECT_URL="your_direct_url_here"
NEXTAUTH_URL=https://tosom.no
NEXTAUTH_SECRET="GENERER_EN_NY_SECRET_HER"
API_BASE_URL=https://api.tosom.no
FRONTEND_BASE_URL=https://tosom.no

# ─── SMTP / Magic Link ───
EMAIL_SERVER_HOST=smtp.resend.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=resend_user
EMAIL_SERVER_PASSWORD=your_resend_api_key
EMAIL_FROM="ToSom <no-reply@tosom.no>"

# ─── AI ───
AI_API_KEY="SETT_INN_DIN_AI_NOKKEL_HER"
AI_MODEL=gpt-4

# ─── Upload ───
UPLOADTHING_TOKEN="SETT_INN_UPLOADTHING_TOKEN"

# ─── Logging & sikkerheit ───
LOG_LEVEL=info
ENABLE_AI_LOGGING=true
ENABLE_AUDIT_LOG=true
HTTPS=true
HSTS_MAX_AGE=31536000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_MAX_LOGIN_ATTEMPTS=5
CACHE_TTL=300
ADMIN_PASSWORD="admin"

# ─── Cron-Job Secret ───
CRON_SECRET="SETT_INN_CRON_SECRET_HER"
