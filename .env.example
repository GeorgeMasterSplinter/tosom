# ToSom — Environment Variables Template
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ─── Environment ───
NODE_ENV=development
TOSOM_ENV=development

# ─── Auth.js (NextAuth v5) ───
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ⚠️ Do NOT change after first start! It invalidates existing sessions.
AUTH_SECRET=your_auth_secret_here
NEXTAUTH_SECRET=your_nextauth_secret_here

# ─── NextAuth URL ───
NEXTAUTH_URL=http://localhost:3000

# ─── Database (PostgreSQL) ───
DATABASE_URL=postgresql://user:password@localhost:5432/tosom_dev
DIRECT_URL=postgresql://user:password@localhost:5432/tosom_dev

# ─── Feature Flags ───
DEV_LOGIN_ENABLED=false

# ─── Email (SMTP) ───
EMAIL_SERVER_HOST=localhost
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="ToSom <dev@tosom.no>"

# ─── Frontend / API URLs ───
FRONTEND_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000

# ─── Logging ───
LOG_LEVEL=debug

# ─── Admin (Development only — use proper auth in production!) ───
ADMIN_EMAIL=admin@tosom.dev
ADMIN_PASSWORD=change_me_in_production

# ─── Cron (for matching & journey jobs) ───
CRON_SECRET=your_cron_secret_here

# ─── Pusher (Realtime chat) ───
PUSHER_APP_ID=your_pusher_app_id
PUSHER_KEY=your_pusher_key
PUSHER_SECRET=your_pusher_secret
PUSHER_CLUSTER=your_pusher_cluster

# ─── UploadThing (File uploads) ───
UPLOADTHING_TOKEN=your_uploadthing_token

# ─── Stripe (Payments — optional for MVP) ───
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# ─── Production extras ───
# HTTPS=true
# HSTS_MAX_AGE=31536000
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100
# RATE_LIMIT_MAX_LOGIN_ATTEMPTS=5
# CACHE_TTL=300