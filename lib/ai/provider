/**
 * ToSom — AI Provider Abstraction
 *
 * Gir ein generisk AI-provider interface som kan bytast ut
 * med OpenAI, Anthropic, Azure OpenAI, eller andre providers.
 */

import 'server-only'

/**
 * AI Provider interface
 */
export interface AIProvider {
  /** Generer match-insights basert på to profiler */
  generateMatchInsights(profileA: Record<string, unknown>, profileB: Record<string, unknown>): Promise<MatchInsights>

  /** Generer journey-step kontekst */
  generateJourneyContext(journeyState: Record<string, unknown>): Promise<JourneyContext>

  /** Generer profil-forslag */
  generateProfileSuggestions(profile: Record<string, unknown>): Promise<ProfileSuggestions>
}

/** Match-insights output */
export interface MatchInsights {
  summary: string
  strengths: string[]
  conversationStarter: string
  depth: 'gentle' | 'moderate' | 'strong' | 'deep'
}

/** Journey-kontekst output */
export interface JourneyContext {
  reflectionQuestion: string
  suggestedTopic: string
  gentlePrompt: string
}

/** Profil-forslag output */
export interface ProfileSuggestions {
  bioVariants: { tone: string; text: string }[]
  interestSuggestions: string[]
  improvementTips: string[]
}

/**
 * OpenAI Provider (brukar AI_API_KEY)
 */
export class OpenAIProvider implements AIProvider {
  private apiKey: string
  private baseUrl: string

  constructor(apiKey: string = process.env.AI_API_KEY ?? process.env.OPENAI_API_KEY ?? '') {
    this.apiKey = apiKey
    this.baseUrl = process.env.OPENAI_BASE_URL ?? 'https://api.openai.com/v1'
  }

  async generateMatchInsights(profileA: Record<string, unknown>, profileB: Record<string, unknown>): Promise<MatchInsights> {
    if (!this.apiKey) {
      return {
        summary: 'Match basert på verdi-kompatibilitet.',
        strengths: ['Delte verdiar', 'Kompatibel livsstil'],
        conversationStarter: 'Kva er det viktigaste for deg i ein relasjon?',
        depth: 'moderate',
      }
    }

    try {
      const response = await fetch(`${this.baseUrl}/chat/completions`, {
        method: 'POST',
        headers: {
          'Authorization': `Bearer ${this.apiKey}`,
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          model: 'gpt-4o-mini',
          messages: [
            {
              role: 'system',
              content: `Du er ein ToSom-match分析师. Gi kort, varme match-insights på norsk.`,
            },
            {
              role: 'user',
              content: JSON.stringify({ profileA, profileB }),
            },
          ],
          max_tokens: 300,
          temperature: 0.7,
        }),
      })

      const data = await response.json()
      const text = data.choices?.[0]?.message?.content ?? ''

      return {
        summary: text.slice(0, 150),
        strengths: ['AI-analyse tilgjengeleg'],
        conversationStarter: 'Fortel meg om deg sjølv — kva gjer deg spesiell?',
        depth: 'moderate',
      }
    } catch {
      return {
        summary: 'Match basert på verdi-kompatibilitet.',
        strengths: ['Delte verdiar'],
        conversationStarter: 'Kva er det viktigaste for deg i ein relasjon?',
        depth: 'gentle',
      }
    }
  }

  async generateJourneyContext(journeyState: Record<string, unknown>): Promise<JourneyContext> {
    if (!this.apiKey) {
      return {
        reflectionQuestion: 'Kva kjende du mest under dagens samtale?',
        suggestedTopic: 'Dagleg liv',
        gentlePrompt: 'Fortel meg meir om det.',
      }
    }

    try {
      const response = await fetch(`${this.baseUrl}/chat/completions`, {
        method: 'POST',
        headers: {
          'Authorization': `Bearer ${this.apiKey}`,
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          model: 'gpt-4o-mini',
          messages: [
            {
              role: 'system',
              content: `Du er ein ToSom-veileiar. Gi dype, men rolege refleksjonsspørsmål på norsk.`,
            },
            {
              role: 'user',
              content: JSON.stringify(journeyState),
            },
          ],
          max_tokens: 200,
          temperature: 0.7,
        }),
      })

      const data = await response.json()
      const text = data.choices?.[0]?.message?.content ?? ''

      return {
        reflectionQuestion: text.slice(0, 100),
        suggestedTopic: 'Djupare samtale',
        gentlePrompt: 'Ta det roleg. Fortel meg kva du tenkjer.',
      }
    } catch {
      return {
        reflectionQuestion: 'Kva kjende du mest under dagens samtale?',
        suggestedTopic: 'Dagleg liv',
        gentlePrompt: 'Fortel meg meir om det.',
      }
    }
  }

  async generateProfileSuggestions(profile: Record<string, unknown>): Promise<ProfileSuggestions> {
    if (!this.apiKey) {
      return {
        bioVariants: [
          { tone: 'rolig', text: 'Ein roleg sjel som set pris på rolege øyeblikk.' },
          { tone: 'lekende', text: 'Alltid klar for ein ny oppleving.' },
          { tone: 'moden', text: 'Søker noko ekte og varig.' },
        ],
        interestSuggestions: ['Lesing', 'Mat', 'Natur'],
        improvementTips: ['Legg til meir om deg sjølv'],
      }
    }

    try {
      const response = await fetch(`${this.baseUrl}/chat/completions`, {
        method: 'POST',
        headers: {
          'Authorization': `Bearer ${this.apiKey}`,
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          model: 'gpt-4o-mini',
          messages: [
            {
              role: 'system',
              content: `Du er ein ToSom-profilhjelpar. Gi kort, hjelpande tips på norsk.`,
            },
            {
              role: 'user',
              content: JSON.stringify(profile),
            },
          ],
          max_tokens: 300,
          temperature: 0.7,
        }),
      })

      const data = await response.json()
      const text = data.choices?.[0]?.message?.content ?? ''

      return {
        bioVariants: [
          { tone: 'rolig', text: text.slice(0, 50) },
          { tone: 'lekende', text: text.slice(0, 50) },
          { tone: 'moden', text: text.slice(0, 50) },
        ],
        interestSuggestions: ['Opplevingar', 'Samtaler', 'Utvikling'],
        improvementTips: ['AI-forslag tilgjengeleg'],
      }
    } catch {
      return {
        bioVariants: [
          { tone: 'rolig', text: 'Ein roleg sjel som set pris på rolege øyeblikk.' },
          { tone: 'lekende', text: 'Alltid klar for ein ny oppleving.' },
          { tone: 'moden', text: 'Søker noko ekte og varig.' },
        ],
        interestSuggestions: ['Lesing', 'Mat', 'Natur'],
        improvementTips: ['Legg til meir om deg sjølv'],
      }
    }
  }
}

/** Default provider — bruk OpenAI dersom AI_API_KEY er sett */
export const defaultAIProvider = new OpenAIProvider()