{
  "port": 3000,
  "logLevel": "info",
  "rateLimit": {
    "windowMs": 900000,
    "maxRequests": 100,
    "maxLoginAttempts": 5
  },
  "cache": {
    "ttl": 300
  },
  "security": {
    "https": true,
    "hsts": true,
    "csp": true,
    "xssProtection": true,
    "frameOptions": "DENY",
    "referrerPolicy": "strict-origin-when-cross-origin"
  }
}