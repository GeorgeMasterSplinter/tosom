# ============================================================
# ToSom — Environment Variables
# Kopier til .env og fyll ut verdiene for ditt miljø.
# ============================================================

# --- Required ---
DATABASE_URL="postgresql://user:password@localhost:5432/tosom_dev"
NEXTAUTH_SECRET="CHANGE_ME_USE_CRYPTOGRAPHICALLY_SECURE_RANDOM_STRING"
NEXTAUTH_URL="http://localhost:3000"

# --- Admin ---
ADMIN_JWT_SECRET="CHANGE_ME_SAME_OR_DIFFERENT_FROM_NEXTAUTH_SECRET"
ADMIN_JWT_EXPIRY="8h"
ADMIN_EMAIL="admin@tosom.no"
ADMIN_PASSWORD="CHANGE_ME_STRONG_PASSWORD"

# --- Cron ---
CRON_SECRET="CHANGE_ME_RANDOM_SECRET"

# --- AI (Matching motor - ENHETEN tillatte AI-modul) ---

# --- Vipps OAuth ---
VIPPS_CLIENT_ID=""
VIPPS_CLIENT_SECRET=""
VIPPS_HOST="api.vipps.no"

# --- Betaling ---
# Stripe er forkastet. Vipps er eneste planlagte betalingsvei (se deploy/payments.md).
# Ingen betalings- eller webhook-miljøvariabler finnes i dag.
# PAYMENTS_ENABLED må forblive false til Vipps er koblet opp.
PAYMENTS_ENABLED=false

# --- UploadThing (bildeopplasting) ---
UPLOADTHING_TOKEN=""
NEXT_PUBLIC_UPLOADTHING_TOKEN=""

# --- Pusher (realtime) ---
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER="eu"
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="eu"

# --- Supabase ---
SUPABASE_URL=""
SUPABASE_KEY=""

# --- Bilde-lagring (R2 / lokal) ---
# STORAGE_DRIVER: auto | r2 | local
#   auto  -> R2 om R2_*-nøklar er sett, elles lokal (dev/CI)
#   r2    -> krev R2_*-nøklar (produksjon)
#   local -> fil på disk (berre utvikling) — IKKE for produksjon
STORAGE_DRIVER="auto"
# R2 (Cloudflare, EU-region). Set i Vercel — aldri i repo.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_REGION="eu-central-1"
# R2_ENDPOINT=""   # valgfritt override; standard: https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com
# Levetid for signerte bilete-URL-er (sekundar). Standard: 900 (15 min).
IMAGE_URL_TTL_SECONDS=900
# Lokal driver: røtmappa for bilete (berre dev). Standard: <tmpdir>/tosom-images
# STORAGE_LOCAL_DIR=""

# --- E-post (magic-link, varsler) ---
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="ToSom <no-reply@tosom.no>"

# --- JWT (generelt) ---
JWT_SECRET="CHANGE_ME_RANDOM_SECRET"

# --- Server konfigurasjon ---
PORT=3000
LOG_LEVEL="debug"
API_BASE_URL=""
FRONTEND_BASE_URL=""

# --- App URL ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# --- Funksjonsswitcher ---
MAINTENANCE_ENABLED=false
DEV_LOGIN_ENABLED=true

# --- Valgfrie feature flags ---
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
NEXT_PUBLIC_UMAAMI_SCRIPT_ID=""
# Sentry DSN — settes i Vercels miljøvariabler (Settings → Environment Variables) før beta.
# Skriv IKKE en ekte DSN inn i repoet. Tom verdi = Sentry slår av seg selv (se beforeSend).
NEXT_PUBLIC_SENTRY_DSN=""
ENABLE_RATE_LIMITING=false
ENABLE_AUDIT_LOG=true
ENABLE_CORS_WHITELIST=false
ENABLE_CSRF_PROTECTION=false