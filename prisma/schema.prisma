generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  name                String? // Brukarnamn til visning
  password            String?
  phone               String?
  phoneVerified       Boolean              @default(false)
  onboardingStep      Int                  @default(1)
  onboardingComplete  Boolean              @default(false)
  deepProfileComplete Boolean              @default(false)
  role                Role                 @default(USER)
  journeyState        JourneyUserState     @default(IDLE)
  matchQueuedAt       DateTime?
  verified            Boolean              @default(false)
  bannedAt            DateTime?
  deletedAt           DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  lastMatchAt         DateTime?
  lockedUntil         DateTime?
  // PRESENCE (v2, DB-basert — Vercel-safe): online-tilstand og skriveindikator.
  // lastSeenAt: siste hjartetikk frå chatsida → «Online» medan < 90 s.
  // typingUntil: medan dette er i framtid → «Skriver…» (settest av klienten).
  lastSeenAt          DateTime?
  typingUntil         DateTime?
  // B4.1 — Vilkårssamtykke lagres med tidsstempel og versjon
  termsAcceptedAt     DateTime?
  termsVersion        String?
  withdrawalWaiverAt  DateTime? // Angrerett-samtykke (ved betaling)
  accounts            Account[]
  auditLogs           AuditLog[]           @relation("AdminAuditLogs")
  conversationsA      Conversation[]       @relation("ConversationToUserA")
  conversationsB      Conversation[]       @relation("ConversationToUserB")
  // journeys (many, match-scoped etter B4) — les via JourneyProgress.where({ userId })
  matchesA            Match[]              @relation("UserAMatches")
  matchesB            Match[]              @relation("UserBMatches")
  messages            Message[]
  notifications       Notification[]
  resetTokens         PasswordResetToken[]
  profile             Profile?             @relation("UserProfile")
  sessions            Session[]
  twoFactor           TwoFactorSecret?

  @@index([journeyState])
  @@index([matchQueuedAt])
  @@index([role])
  @@index([email])
  @@index([lastMatchAt])
  @@index([lockedUntil])
}

// ⚠️ TODO: age burde vere required basert på 9-stegs onboarding (ikkje nullable)
model Profile {
  id                  String          @id @default(cuid())
  userId              String          @unique
  firstName           String?
  lastName            String?
  age                 Int // ⚠️ ENDRA frå optional → required
  identityName        String?
  lifeSituation       Json?
  lifestyle           Json?
  personality         Json?
  relationshipStyle   String?
  communication       Json?
  intimacy            Json?
  futureVision        Json?
  boundaries          Json?
  emotionalNeeds      Json?
  lifeRhythm          String?
  maturityLevel       Int?
  securityLevel       String?
  photoUrl            String?
  bio                 String?
  interests           String[]
  // B1.3: Avstands-matching — postnummer som kolonne (filterbar), lat/lon utledet ved lagring
  postalCode          String?
  latitude            Float?
  longitude           Float?
  deepProfileStep     DeepProfileStep @default(IDENTITY)
  deepProfileData     Json?
  // Onboarding-utkast ({ step, data }) underveis i onboarding — eget hjem slik at
  // draft-autosave aldri overskriver deepProfileData (matching-data). Ryddes ved fullføring.
  onboardingDraft     Json?
  preferences         Json?
  matchTags           String[]
  // FORSKNINGSMOTOR F-3: Psykometriske skårer (additive, ingen eksisterende felt røres)
  psychometricAnswers Json? // Rå svar: { "bfi1": 4, "att_a1": 2, ... }
  bigFive             Json? // { openness, conscientiousness, extraversion, agreeableness, neuroticism }
  attachment          Json? // { anxiety, avoidance, style }
  valueProfile        Json? // { benevolence, security, ... } (PVQ-10)
  emotionRegulation   Json? // { reappraisal, suppression } (ERQ-6)
  psychometricVersion String? // Versjon av instrumentsettet
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  user                User            @relation("UserProfile", fields: [userId], references: [id])

  @@index([userId])
  @@index([deepProfileStep])
  @@index([matchTags])
  @@index([latitude, longitude])
}

// B8: Samtykkefelt fjernet — se TOSOM-MASTERPLAN-v3.0 DEL 2
model Match {
  id               String         @id @default(cuid())
  userAId          String
  userBId          String
  status           MatchStatus    @default(active)
  score            Int            @default(0)
  normalizedScore  Float
  type             String         @default("standard")
  explanation      Json?
  scoringBreakdown Json?
  resonanceLevel   ResonanceLevel @default(GENTLE)
  reviewed         Boolean        @default(false)
  lockedAt         DateTime?
  expiresAt        DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  userA            User           @relation("UserAMatches", fields: [userAId], references: [id])
  userB            User           @relation("UserBMatches", fields: [userBId], references: [id])

  @@unique([userAId, userBId])
  @@index([status])
  @@index([userAId, status])
  @@index([userBId, status])
  @@index([userAId])
  @@index([userBId])
  @@index([createdAt])
  @@index([expiresAt])
  @@index([score])
  @@index([normalizedScore])
}

model Conversation {
  id                  String             @id @default(cuid())
  userAId             String
  userBId             String
  matchId             String?            @unique
  endedAt             DateTime?
  lastMessageAt       DateTime?
  lastMessagePreview  String?
  unreadCountA        Int                @default(0)
  unreadCountB        Int                @default(0)
  frozenAt            DateTime?
  frozenBy            String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  imageShareAllowedAt DateTime?
  imageShared         Boolean            @default(false)
  mood                String             @default("warm")
  userA               User               @relation("ConversationToUserA", fields: [userAId], references: [id])
  userB               User               @relation("ConversationToUserB", fields: [userBId], references: [id])
  stateLogs           JourneyStateLog[]
  messages            Message[]
  resonanceSessions   ResonanceSession[]
  gameSessions        GameSession[]

  @@index([userAId, userBId])
  @@index([matchId])
  @@index([endedAt])
  @@index([frozenAt])
  @@index([lastMessageAt])
  @@index([imageShareAllowedAt])
}

model Message {
  id             String          @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  type           MessageCategory @default(user)
  // STEG: R2-bildelagring. Nøkkel til objektlagring (R2) når type=image.
  // Null for tekst-meldinger. Brukes til (1) å utstede signerte URL-er ved lesing
  // og (2) å slette filen ved reiseslutt (GDPR art. 17). Aldri en offentlig sti.
  imageKey       String?
  // CHAT-POLISH (C-2): kjelde for boble-etikett — 'bli_kjent' | 'oppgave' | null.
  // Fritt tekstfelt (ikkje enum): nye kjelder krev ingen ny migrasjon.
  source         String?
  state          MessageState    @default(SENT)
  deliveredAt    DateTime?
  readAt         DateTime?
  deletedAt      DateTime?
  editedAt       DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  conversation   Conversation    @relation(fields: [conversationId], references: [id])
  sender         User            @relation(fields: [senderId], references: [id])

  @@index([createdAt])
  @@index([conversationId, createdAt])
}

// ⚠️ TODO: Legg til CHECK constraint (day >= 1 AND day <= 30) etter at vi migrerer til Prisma v6+ (supportar @@check)
// STEG B4 — match-scoped JourneyProgress: ONE record per user per match
model JourneyProgress {
  id            String             @id @default(cuid())
  userId        String
  matchId       String
  phase         JourneyPhase       @default(EARLY)
  day           Int                @default(0) // 0 = ikke startet; validering i API-nivå (day >= 1 AND day <= 30)
  completedDays Int                @default(0)
  userASeenAt   DateTime?
  userBSeenAt   DateTime?
  bothSeenAt    DateTime? // null = reisen har ikke startet ennå
  nextDayAt     DateTime?
  startedAt     DateTime           @default(now())
  endedAt       DateTime?
  pausedAt      DateTime?
  resumedAt     DateTime?
  completedAt   DateTime?
  continueA     String?
  continueB     String?
  updatedAt     DateTime           @updatedAt
  milestones    JourneyMilestone[]

  @@unique([userId, matchId], name: "jp_user_match")
  @@index([userId])
  @@index([matchId])
  @@index([bothSeenAt])
  @@index([nextDayAt]) // B-3: journey-cron filtrerer på nextDayAt <= NOW (hver time)
}

model JourneyStateLog {
  id             String       @id @default(cuid())
  conversationId String
  fromState      JourneyState
  toState        JourneyState
  reason         String? // kva som utløyste endringa
  triggeredBy    String? // "user_a", "user_b", "system", "admin"
  createdAt      DateTime     @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
  @@index([createdAt])
}

model JourneyMilestone {
  id         String          @id @default(cuid())
  progressId String
  day        Int
  title      String
  summary    String
  createdAt  DateTime        @default(now())
  progress   JourneyProgress @relation(fields: [progressId], references: [id])

  @@unique([progressId, day])
  @@index([progressId])
  @@index([day])
}

model ResonanceSession {
  id              String       @id @default(cuid())
  conversationId  String
  day             Int
  emotionalTone   String
  depthLevel      Int
  responseQuality String
  mutualSharing   Boolean
  vulnerability   Boolean
  summary         String?
  createdAt       DateTime     @default(now())
  conversation    Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId, day])
  @@index([conversationId])
}

model JourneyDayContent {
  id                 String       @id @default(cuid())
  day                Int          @unique
  theme              String
  phase              JourneyPhase
  reflectionQuestion String
  conversationPrompt String
  task               String?
  resonanceGoal      String
  systemMessage      String?
  createdAt          DateTime     @default(now())

  @@index([day])
}

// Guidede spørsmål-kategoriar for chat-guiding
model QuestionCategory {
  id          String           @id @default(cuid())
  name        String           @unique // "Trygghet", "Verdier", osv.
  description String
  order       Int
  icon        String? // ikon-navn (Feather/SVG)
  color       String? // gull/blue accent hex
  questions   GuidedQuestion[]
  createdAt   DateTime         @default(now())

  @@index([order])
}

model GuidedQuestion {
  id         String           @id @default(cuid())
  categoryId String
  category   QuestionCategory @relation(fields: [categoryId], references: [id])
  content    String // spørsmåls-texten
  depthLevel Int              @default(1) // 1=surface, 2=mid, 3=deep
  order      Int
  createdAt  DateTime         @default(now())

  @@index([categoryId, order])
  @@index([depthLevel])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType @default(SYSTEM)
  message   String
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([userId, readAt, createdAt])
  @@index([type])
  @@index([readAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([tokenHash])
}

model MagicLinkToken {
  id        String    @id @default(cuid())
  email     String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([token])
  @@index([expiresAt])
}

model PhoneVerification {
  id        String    @id @default(cuid())
  userId    String
  phone     String
  code      String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([phone])
  @@index([code])
}

model TwoFactorSecret {
  id          String   @id @default(cuid())
  userId      String   @unique
  secret      String   @unique
  enabled     Boolean  @default(false)
  backupCodes String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
}

model AuditLog {
  id        String      @id @default(cuid())
  // S-9: adminId er nullable + SetNull. Ved permanent kontosletting (found_each_other)
  // MÅ AuditLog overleve i anonymisert form — aktøren nulls ut i stedet for at loggen
  // forsvinner (eller at slettingen feiler på FK).
  adminId   String?
  action    AuditAction
  metadata  String?
  createdAt DateTime    @default(now())
  admin     User?       @relation("AdminAuditLogs", fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
}

model SystemLog {
  id        String   @id @default(cuid())
  level     LogLevel
  message   String
  module    String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([level])
  @@index([module])
  @@index([createdAt])
}

model PerformanceMetric {
  id        String     @id @default(cuid())
  route     String
  metric    PerfMetric
  valueMs   Int
  createdAt DateTime   @default(now())

  @@index([route])
  @@index([metric])
  @@index([createdAt])
}

/// F2-2: Atomiske kvote-tellere (race-frie grenseoverskridelser).
/// Gratiskvoten var tidlegare check-then-create (count Order, deretter
/// create) — to samtidige onboardingar kunne begge seie «4 999 < 5 000»
/// og begge slippe gjennom. claimFreeQuota gjer éin betinga
/// UPDATE ... SET used = used+1 WHERE used < cap — Postgres sin row-lock
/// gjer at berre éin vinn grenseplassen. Raden 'free_users' blir seeda
/// av migreringa (backfill frå Order-teljinga).
model Quota {
  id        String   @id
  used      Int      @default(0)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  sessionToken String   @unique
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// STEG B8: MatchInsight er DELETED — ingen ruter skrev til den siden v2.0

model SystemMessage {
  id        String            @id
  content   String
  type      SystemMessageType @default(INFO)
  createdAt DateTime          @default(now())
}

enum Role {
  USER
  ADMIN
  SUPPORT
}

enum JourneyPhase {
  EARLY
  BUILDING_TRUST
  DEEPER
  CHECKIN
}

enum DeepProfileStep {
  IDENTITY
  LIFE_SITUATION
  LIFESTYLE
  PERSONALITY
  RELATIONSHIP_STYLE
  COMMUNICATION
  INTIMACY
  FUTURE_VISION
  BOUNDARIES
  // @deprecated — beholdes som terminal-markør for fullført onboarding (15+ referanser)
  SUMMARY
}

enum JourneyState {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  PAUSED
}

enum ResonanceLevel {
  GENTLE
  MODERATE
  STRONG
  DEEP
}

// STEG B8: Fra 6 verdier til 3
enum MatchStatus {
  active // koblet, reise pågår
  ended // avsluttet — normalt slettet umiddelbart
  expired // forlatt i 14 dager uten at begge var innom
}

enum MessageCategory {
  user
  system
  continue_choice
  image
}

enum MessageState {
  SENT
  DELIVERED
  READ
  DELETED
}

enum AdminAction {
  USER_BAN
  USER_UNBAN
  USER_VERIFY
  USER_DEACTIVATE
  USER_ACTIVATE
  CONTENT_DELETE
  JOURNEY_RESET
  CONVERSATION_FREEZE
  SYSTEM_ALERT
  SETTINGS_CHANGE
}

enum AuditAction {
  USER_BAN
  USER_UNBAN
  USER_VERIFY
  USER_DEACTIVATE
  USER_ACTIVATE
  CONTENT_DELETE
  JOURNEY_RESET
  CONVERSATION_FREEZE
  ADMIN_LOGIN
  TWOFA_ENABLE
  TWOFA_DISABLE
  ADMIN_SETTINGS_CHANGE
  PASSWORD_RESET
}

enum NotificationType {
  MATCH
  MESSAGE
  JOURNEY
  SYSTEM
  ADMIN
}

enum LogLevel {
  INFO
  WARN
  ERROR
  DEBUG
}

enum PerfMetric {
  api_latency
  db_latency
}

enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
}

enum SystemMessageType {
  INFO
  WARNING
  ALERT
}

model MatchHistory {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  matchId   String? // Original match ID
  endedAt   DateTime @default(now())
  outcomeA  String? // "finished", "abandoned", "reported"
  outcomeB  String?
  createdAt DateTime @default(now())

  @@unique([userAId, userBId], name: "uh_idx")
  @@index([userAId])
  @@index([userBId])
  @@index([createdAt])
}

/// User journey state machine (B1 additive migration)
enum JourneyUserState {
  IDLE /// Not in queue, not matched
  QUEUED /// In matching queue (via "Start reisen")
  MATCHED /// Matched but not yet both seen
  ON_JOURNEY /// Both saw each other, journey running
  COMPLETED /// Journey finished (30 days or manual exit)
}

enum ReportCategory {
  HARASSMENT
  INAPPROPRIATE
  SPAM
  FAKE_PROFILE
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWED
  ACTIONED
  DISMISSED
}

// BETA — Invitasjonsport (lukket beta). Adressen er nøkkelen: kun inviterte
// får magic link sendt. usedAt = når invitasjonen ble tatt i bruk.
model BetaInvite {
  id        String    @id @default(cuid())
  email     String    @unique
  invitedAt DateTime  @default(now())
  usedAt    DateTime?
  note      String?

  @@index([usedAt])
}

// STEG S1 — Sperreliste: bruker blokkerer en annen fra påtreffende matching
model UserBlock {
  id        String   @id @default(cuid())
  blockerId String // hvem som blokkerer
  blockedId String // hvem som blokkeres (aldri blir matchet med blocker)
  matchId   String? // lenke til matchen (historikk, kan være null)
  reason    String? // "blocked" | "reported"
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

// STEG C1 — Brukerstyrt rapportering
model Report {
  id          String         @id @default(cuid())
  reporterId  String
  reportedId  String
  matchId     String?
  category    ReportCategory
  description String?
  status      ReportStatus   @default(OPEN)
  createdAt   DateTime       @default(now())
  reviewedAt  DateTime?
  reviewedBy  String?

  @@index([status, createdAt])
  @@index([reportedId])
}

// STEG G1 — Order-modell og betalingsgrensesnitt
model Order {
  id               String      @id @default(cuid())
  userId           String
  amount           Int         @default(34900) // øre
  currency         String      @default("NOK")
  status           OrderStatus @default(PENDING)
  provider         String      @default("vipps")
  providerRef      String?     @unique
  freeQuota        Boolean     @default(false)
  withdrawalWaiver Boolean     @default(false) // angrerett, C4
  waiverAt         DateTime?
  createdAt        DateTime    @default(now())
  completedAt      DateTime?

  @@index([userId, status])
  @@index([status, createdAt])
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// STEG G1 — WebhookEvent for idempotens (Vipps sender samme hendelse flere ganger)
model WebhookEvent {
  id         String   @id // provider-ID → idempotens
  provider   String
  payload    Json
  receivedAt DateTime @default(now())

  @@index([provider, receivedAt])
}

// B4.6 — JourneyStat: Anonym statistikk ved reiseslutt (I-14)
// Ingen ID-er, ingen navn, ingen innhold, ingen posisjon.
// resonanceLevel + outcome er kombinasjonen som validerer hele matchemotoren.
model JourneyStat {
  id             String   @id @default(cuid())
  endedAt        DateTime @default(now())
  outcome        String // found_each_other | new_journey | early_exit | expired
  daysCompleted  Int
  messageCount   Int
  bothActive     Boolean
  resonanceLevel String // DEEP | STRONG | MODERATE | GENTLE
  ageBandA       String // «23-29» — bånd, ikke alder
  ageBandB       String
  distanceBand   String // «0-25km» — bånd, ikke posisjon
  usedBliKjent   Boolean

  @@index([endedAt])
  @@index([outcome])
}

// Dag 12 — Delt rate limiting via Postgres.
// Enkel teller per nøkkel med tidsvindu. Atomisk UPSERT for serverless-sikkerhet.
model RateLimitCounter {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())

  @@index([resetAt])
}

// ─── Spill i chat (Strøm B) ───
// Lavterskel minispill som isbrytere. Ingen poeng, ingen serier, ingen gamification.
// Én aktiv økt per spilltype per samtale. Serveren er alltid fasit.

enum GameType {
  TTT
  RPS
}

enum GameStatus {
  ACTIVE
  COMPLETED
}

model GameSession {
  id             String     @id @default(cuid())
  conversationId String
  type           GameType
  state          Json // TTT: { board, turn }; RPS: { choiceA, choiceB }
  turn           String? // userId — kun TTT; null for RPS (samtidig)
  winner         String? // userId | null (uavgjort)
  status         GameStatus @default(ACTIVE)
  startedBy      String // userId
  createdAt      DateTime   @default(now())
  completedAt    DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
  @@index([status])
}
