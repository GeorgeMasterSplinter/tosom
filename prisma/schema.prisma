generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum JourneyPhase {
  EARLY
  BUILDING_TRUST
  DEEPER
  CHECKIN
}

enum DeepProfileStep {
  IDENTITY
  LIFE_SITUATION
  LIFESTYLE
  PERSONALITY
  RELATIONSHIP_STYLE
  COMMUNICATION
  INTIMACY
  FUTURE_VISION
  BOUNDARIES
  SUMMARY
}

enum JourneyState {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum ResonanceLevel {
  GENTLE
  MODERATE
  STRONG
  DEEP
}

enum MatchStatus {
  pending
  active
  matched
  expired
  ended
  unmatched
}

enum QueueStatus {
  PENDING
  MATCHED
  EXPIRED
}

enum MessageCategory {
  user
  system
  continue_choice
  image
}

enum MessageState {
  SENT
  DELIVERED
  READ
  DELETED
}

enum AdminAction {
  USER_BAN
  USER_UNBAN
  USER_VERIFY
  USER_DEACTIVATE
  USER_ACTIVATE
  CONTENT_DELETE
  JOURNEY_RESET
  CONVERSATION_FREEZE
  SYSTEM_ALERT
  SETTINGS_CHANGE
}

enum AuditAction {
  USER_BAN
  USER_UNBAN
  USER_VERIFY
  USER_DEACTIVATE
  USER_ACTIVATE
  CONTENT_DELETE
  JOURNEY_RESET
  CONVERSATION_FREEZE
  ADMIN_LOGIN
  TWOFA_ENABLE
  TWOFA_DISABLE
  ADMIN_SETTINGS_CHANGE
  PASSWORD_RESET
}

enum NotificationType {
  MATCH
  MESSAGE
  JOURNEY
  SYSTEM
  ADMIN
}

enum SystemMessageType {
  INFO
  WARNING
  ALERT
}

enum LogLevel {
  INFO
  WARN
  ERROR
  DEBUG
}

enum PerfMetric {
  api_latency
  db_latency
}

enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
}

enum AIFeature {
  journeyGuidance
  matchInsights
  messageSuggestions
  profileRewrite
}

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  password         String?
  phone            String?
  phoneVerified    Boolean          @default(false)
  onboardingStep   Int              @default(1)
  onboardingComplete Boolean        @default(false)
  deepProfileComplete Boolean        @default(false)
  role             Role              @default(USER)
  verified         Boolean           @default(false)
  bannedAt         DateTime?
  deletedAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // Match-kontroll (core-definition: éin match per 24t, låst i 30d)
  lastMatchAt      DateTime?
  lockedUntil      DateTime?

  profile          Profile?                       @relation("UserProfile")
  conversationsA   Conversation[]                 @relation("ConversationToUserA")
  conversationsB   Conversation[]                 @relation("ConversationToUserB")
  messages         Message[]
  matchesA         Match[]                        @relation("UserAMatches")
  matchesB         Match[]                        @relation("UserBMatches")
  journey          JourneyProgress?               @relation("UserJourney")
  notifications    Notification[]
  resetTokens      PasswordResetToken[]
  twoFactor        TwoFactorSecret?
  auditLogs        AuditLog[]                     @relation("AdminAuditLogs")
  matchQueues      MatchQueue[]
  matchFeedbacks   MatchFeedback[]

  // NextAuth / PrismaAdapter
  accounts         Account[]
  sessions         Session[]

  @@index([role])
  @@index([email])
  @@index([lastMatchAt])
  @@index([lockedUntil])
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique

  // --- Basis (lett data) ---
  firstName   String?
  lastName    String?
  age         Int?

  // --- Djup profil (10+ dimensjonar — core-definition) ---
  identityName     String?         // kva brukaren vil kallast
  lifeSituation    Json?           // jobb, bustad, økonomi, kvardag
  lifestyle        Json?           // aktivitetsnivå, sosiale preferansar, helgevanar
  personality      Json?           // styrkar, trekk, natur
  relationshipStyle String?        // korleie brukaren søker relasjon
  communication    Json?           // kommunikasjonspreferanse (modent)
  intimacy         Json?           // intimitet & nærheit (modent)
  futureVision     Json?           // framtidsønsker, dramar, mål
  boundaries       Json?           // grenser, behov, limitasjonar
  emotionalNeeds   Json?           // emosjonelle behov
  lifeRhythm       String?        // livsrytme: "morning" | "evening" | "fast" | "slow"
  maturityLevel    Int?           // modenheit/trygghet: 1-10
  securityLevel    String?        // "unsicher" | "ambivalent" | "secure"

  // --- Lettdata (alltid valfrie, aldri brukt i matching) ---
  photoUrl    String?            // berre éi foto-url (valfritt)
  bio         String?
  interests   String[]

  deepProfileStep DeepProfileStep @default(IDENTITY)
  deepProfileData Json?

  // Matching-felt (ny i FASE 9)
  preferences Json?           // { dealbreakers: string[], preferences: Record<string, string> }
  matchTags String[]          // for rask filtrering i matching

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation("UserProfile", fields: [userId], references: [id])

  @@index([userId])
  @@index([deepProfileStep])
  @@index([matchTags])
}

model Match {
  id            String   @id @default(cuid())
  userAId       String
  userBId       String
  status        MatchStatus @default(active)
  score         Int      @default(0)
  normalizedScore Float        // 0.0–1.0 (ny i FASE 9)
  type          String   @default("pending")
  explanation   Json?
  scoringBreakdown Json?      // { base, resonance, semantic, intimacy, future }
  resonanceLevel ResonanceLevel @default(GENTLE)
  reviewed      Boolean  @default(false)
  acceptedByA   DateTime?
  acceptedByB   DateTime?
  lockedAt      DateTime?
  expiresAt     DateTime?
  
  // Dealbreaker-tracking (ny i FASE 9)
  rejectedByA   DateTime?
  rejectedByB   DateTime?
  rejectionReason String?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

   userA         User              @relation("UserAMatches", fields: [userAId], references: [id])
   userB         User              @relation("UserBMatches", fields: [userBId], references: [id])
   history       MatchHistory[]
   feedbacks     MatchFeedback[]
   insights      MatchInsight[]

   @@index([status])
   @@index([userAId])
   @@index([userBId])
   @@index([createdAt])
   @@index([expiresAt])
   @@index([score])
   @@index([normalizedScore])
}

model MatchHistory {
  id        String   @id @default(cuid())
  matchId   String
  event     String
  createdAt DateTime @default(now())

  match     Match    @relation(fields: [matchId], references: [id])
}

model MatchQueue {
  id        String        @id @default(cuid())
  userId    String
  status    QueueStatus   @default(PENDING)
  createdAt DateTime      @default(now())

  user      User          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model MatchFeedback {
  id        String   @id @default(cuid())
  matchId   String
  userId    String
  rating    Int
  reason    String?
  createdAt DateTime @default(now())

  match     Match    @relation(fields: [matchId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([matchId])
  @@index([userId])
  @@index([rating])
}

model Conversation {
  id             String        @id @default(cuid())
  userAId        String
  userBId        String
  matchId        String?
  endedAt        DateTime?
  lastMessageAt  DateTime?
  lastMessagePreview String?
  unreadCountA   Int           @default(0)
  unreadCountB   Int           @default(0)
  frozenAt       DateTime?
  frozenBy       String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  journeyStep    JourneyStep?  @relation("ConvToStep")

  // Core-definition: 14 dagar utan bilder
  imageShareAllowedAt DateTime?
  imageShared       Boolean           @default(false)

  userA          User          @relation("ConversationToUserA", fields: [userAId], references: [id])
  userB          User          @relation("ConversationToUserB", fields: [userBId], references: [id])
  messages       Message[]
  resonanceSessions ResonanceSession[]

  @@index([userAId, userBId])
  @@index([matchId])
  @@index([endedAt])
  @@index([frozenAt])
  @@index([lastMessageAt])
  @@index([imageShareAllowedAt])
}

model Message {
  id             String          @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  type           MessageCategory @default(user)
  state          MessageState    @default(SENT)
  deliveredAt    DateTime?
  readAt         DateTime?
  deletedAt      DateTime?
  editedAt       DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  conversation   Conversation    @relation(fields: [conversationId], references: [id])
  sender         User            @relation(fields: [senderId], references: [id])

  @@index([createdAt])
}

model JourneyProgress {
  id           String       @id @default(cuid())
  userId       String       @unique
  phase        JourneyPhase @default(EARLY)
  day          Int          @default(1)
  completedDays Int          @default(0)
  nextDayAt    DateTime?    // 24t-lås per dag
  startedAt    DateTime     @default(now())
  endedAt      DateTime?
  pausedAt     DateTime?
  resumedAt    DateTime?
  completedAt  DateTime?
  continueA    String?
  continueB    String?
  updatedAt    DateTime     @updatedAt

  user         User              @relation("UserJourney", fields: [userId], references: [id])
  milestones   JourneyMilestone[]

  @@index([userId])
}

model JourneyMilestone {
  id         String   @id @default(cuid())
  progressId String
  day        Int
  title      String
  summary    String
  createdAt  DateTime @default(now())

  progress   JourneyProgress? @relation(fields: [progressId], references: [id])

  @@index([progressId])
  @@index([day])
}

model JourneyStep {
  id             String        @id @default(cuid())
  conversationId String        @unique
  conversation   Conversation  @relation("ConvToStep", fields: [conversationId], references: [id])

  phase          JourneyPhase
  order          Int
  title          String
  description    String
  dynamic        Boolean       @default(false)
  isSystemMessage Boolean      @default(false)
  systemMessage  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model ResonanceSession {
  id              String       @id @default(cuid())
  conversationId  String
  day             Int
  emotionalTone   String       // "positive" | "neutral" | "mixed" | "deep"
  depthLevel      Int          // 1-10
  responseQuality String       // "engaged" | "passive" | "neutral" | "resistant"
  mutualSharing   Boolean
  vulnerability   Boolean
  summary         String?
  createdAt       DateTime     @default(now())

  conversation    Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId, day])
  @@index([conversationId])
}

model JourneyDayContent {
  id              String   @id @default(cuid())
  day             Int      // 1-30
  theme           String
  phase           JourneyPhase
  reflectionQuestion String
  conversationPrompt String
  task            String?
  resonanceGoal   String
  systemMessage   String?
  createdAt       DateTime @default(now())

  @@unique([day])
  @@index([day])
}

model SystemMessage {
  id        String             @id @default(cuid())
  content   String
  type      SystemMessageType  @default(INFO)
  createdAt DateTime           @default(now())
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType @default(SYSTEM)
  message   String
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([type])
  @@index([readAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([tokenHash])
}

model MagicLinkToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
  @@index([expiresAt])
}

model PhoneVerification {
  id        String   @id @default(cuid())
  userId    String
  phone     String
  code      String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([phone])
  @@index([code])
}

model TwoFactorSecret {
  id        String   @id @default(cuid())
  userId    String   @unique
  secret    String   @unique
  enabled   Boolean  @default(false)
  backupCodes String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])
}

model AuditLog {
  id         String      @id @default(cuid())
  adminId    String
  action     AuditAction
  metadata   String?
  createdAt  DateTime    @default(now())

  admin      User        @relation("AdminAuditLogs", fields: [adminId], references: [id])

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
}

model SystemLog {
  id        String      @id @default(cuid())
  level     LogLevel
  message   String
  module    String?
  metadata  Json?
  createdAt DateTime    @default(now())

  @@index([level])
  @@index([module])
  @@index([createdAt])
}

model RateLimitLog {
  id        String   @id @default(cuid())
  userId    String?
  route     String
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([route])
  @@index([createdAt])
}

model PerformanceMetric {
   id      String     @id @default(cuid())
   route   String
   metric  PerfMetric
   valueMs Int
   createdAt DateTime @default(now())

   @@index([route])
   @@index([metric])
   @@index([createdAt])
 }

// ─── NextAuth / PrismaAdapter models ───
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  sessionToken String   @unique
  expires      DateTime

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model RouteHit {
  id      String     @id @default(cuid())
  route   String
  method  HttpMethod @default(GET)
  status  Int        @default(200)
  createdAt DateTime @default(now())

  @@index([route])
  @@index([createdAt])
}

model AIRequestLog {
   id        String   @id @default(cuid())
   userId    String
   feature   AIFeature
   model     String
   tokensIn  Int
   tokensOut Int
   latencyMs Int
   success   Boolean
   traceId   String?
   createdAt DateTime @default(now())

   @@index([userId])
   @@index([feature])
   @@index([createdAt])
 }

model MatchInsight {
  id        String   @id @default(cuid())
  matchId   String   @unique
  summary   String
  strengths String
  clarity   String
  starter   String
  model     String?
  tokensOut Int     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  match     Match    @relation(fields: [matchId], references: [id])

  @@index([matchId])
  @@index([createdAt])
}
