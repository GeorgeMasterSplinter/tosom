{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "functions": {
    "app/api/cron/*/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/matching",
      "schedule": "0 2 * * 6"
    },
    {
      "path": "/api/cron/matching",
      "schedule": "15,30 2 * * 6"
    },
    {
      "path": "/api/cron/journey",
      "schedule": "0 4 * * *"
    }
  ]
}
